# Phase 3B: dedicated collector ingest identity (not a user JWT)
COLLECTOR_ENABLED=false
COLLECTOR_ID=windows-local
COLLECTOR_INGEST_KEY=
COLLECTOR_DEMO_RULE_ENABLED=false
COLLECTOR_DEMO_PORT=19090
# Loopback-only requests (127.0.0.1/::1, no forwarded-for headers) are always accepted when
# COLLECTOR_ENABLED=true, regardless of the setting below. Set COLLECTOR_REMOTE_ENABLED=true only
# on the deployed backend to additionally accept requests from a collector running on a remote
# Windows host, over HTTPS, with a timestamp window and a per-key rate limit.
COLLECTOR_REMOTE_ENABLED=false
COLLECTOR_MAX_CLOCK_SKEW_SECONDS=300
COLLECTOR_RATE_LIMIT_PER_MINUTE=300
